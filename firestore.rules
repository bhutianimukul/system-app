rules_version = '2';

// §Social and §Referral. Three things leave the device and nothing else, so these rules are written to make the
// fourth impossible rather than merely discouraged.
//
// **Every path here is six segments and was checked against the code that writes it.** Firestore alternates
// collection/document, so `/gakseong/leagues/{id}/standings/{uid}` matches a collection rather than a document
// and silently denies the write the app actually makes. The first draft did exactly that, and the failure looks
// identical to having no rules at all: PERMISSION_DENIED, with nothing saying the rule never matched.
//
// The project also serves com.gakeseong and a ruleset is project-wide, so everything is namespaced under
// /gakseong.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // cloud/Firebase.kt: collection("gakseong").document("referrals").collection("rows").document(inviteeUid)
    match /gakseong/referrals/rows/{inviteeUid} {
      // §Referral: create only, never update. One credit per invitee UID, ever.
      //
      // The invitee writes their own pairing and can never write anyone else's, so nobody can attribute an
      // install they did not cause. Nothing may change it afterwards, including them.
      allow create: if isSelf(inviteeUid)
                    && request.resource.data.state == 'pending'
                    && request.resource.data.keys().hasOnly(['inviterCode', 'installedOn', 'state']);
      allow read:   if isSelf(inviteeUid);
      allow update, delete: if false;
    }

    // cloud/Ladder.kt: collection("gakseong").document("leagues").collection(letter)
    //                    .document("standings").collection("rows").document(uid)
    match /gakseong/leagues/{league}/standings/rows/{uid} {
      // A hunter writes their own aura total and nobody else's. §Social: the ladder is the one thing in this
      // app that has to be trustworthy, so a row nobody can forge is the whole point.
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(['aura', 'rank', 'updatedAt'])
                            && request.resource.data.aura is int
                            && request.resource.data.aura >= 0
                            // No day can legitimately exceed this, and a ladder is only worth reading if the
                            // numbers on it are possible. §3's daily cap is the reason such a bound exists.
                            && request.resource.data.aura <= 5000;
      allow delete: if false;
    }

    match /gakseong/guilds/rows/{guildId} {
      // §Social: invite only, twenty at most.
      //
      // §Stack says no server code, so a roster has to be made unforgeable by a rule alone. The rule allows
      // exactly one shape of update: the members list gains your own uid and nothing else changes. You can
      // therefore add yourself and never anybody else, and never remove anyone, which is all a Cloud Function
      // would have enforced anyway.
      //
      // Read is open to signed-in users on purpose: the id is the invite code, so somebody holding it is
      // somebody who was invited. Guarding read by membership would make it impossible to look at a guild
      // before joining it, which is the one moment the id exists for.
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.members == [request.auth.uid]
                    && request.resource.data.keys().hasOnly(['name', 'members', 'foundedOn'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24;

      allow update: if signedIn()
                    // Only the roster may move, and only by gaining you.
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members == resource.data.members.concat([request.auth.uid])
                    && !(request.auth.uid in resource.data.members)
                    && request.resource.data.members.size() <= 20;

      // A guild that can be deleted is a guild whose feed can be erased from under its members.
      allow delete: if false;
    }

    match /gakseong/guilds/rows/{guildId}/feed/{postId} {
      // §Social: guild-scoped, twenty a day, and a member may only ever post as themselves.
      allow read: if signedIn()
                  && request.auth.uid in
                     get(/databases/$(database)/documents/gakseong/guilds/rows/$(guildId)).data.members;

      // A member posts as themselves, from the allowlisted set of phrases in cloud/Guild.kt's PostKind. §10
      // reaches here too: a feed post goes to other people, so it may never carry a package name, a duration or
      // a screen-time number. Nothing in a post is free text, which is also why this feed needs no moderation
      // queue and no reporting flow, both of which are Play requirements the moment UGC exists.
      allow create: if isSelf(request.resource.data.authorUid)
                    && request.auth.uid in
                       get(/databases/$(database)/documents/gakseong/guilds/rows/$(guildId)).data.members
                    && request.resource.data.keys().hasOnly(['authorUid', 'text', 'aura', 'at'])
                    && request.resource.data.text.size() <= 40;

      // Written once and never edited. A feed nobody can rewrite is a record rather than a wall.
      allow update, delete: if false;
    }

    // Anything not named above is closed. A collection that appears without a rule is a mistake, and this
    // default makes it a visible one rather than an open door.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
