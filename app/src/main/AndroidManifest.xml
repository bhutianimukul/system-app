<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase, and the one AI endpoint. Nothing else this app does needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Haptics. Composition primitives fire even when the phone is on silent, which is the point. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Special access, not a runtime permission. Declaring it makes the app appear in the system's usage-access
      list; the grant itself only happens in Settings, via Settings.ACTION_USAGE_ACCESS_SETTINGS. Asked at the
      first quest that needs it, never at onboarding.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Health Connect, read only. Three record types and no more, because nothing else is verified.
      Declaring writes would be asking for trust the app does not need: it never writes health data, which is
      also what makes the dataOrigin check in sense/Provenance.kt meaningful.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!--
      The focus session's foreground service. SPECIAL_USE because none of the standard types fit: this is not
      media, not location, not a data sync. It is bounded by the session and shows a notification the whole time.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Do Not Disturb. Special access, granted through Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS rather
      than a runtime dialog, and asked at the first session rather than at onboarding.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      The speed bump. A single user toggle granted through Settings, and the app only draws it while a focus
      session's foreground service is alive. §Verifiers: this is a bump, not containment; real blocking needs
      an AccessibilityService and stays opt-in, earned by repeated failure.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 13 and below reach Health Connect as an installed app rather than a system module. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".App"
        android:label="Gakseong"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gakseong">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gakseong.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              §Referral: App Links plus Install Referrer, because a plain deep link cannot survive the Play
              round-trip and Firebase Dynamic Links is shut down. This half handles the invitee who already has
              the app, where Play never sees the referrer at all.

              autoVerify needs assetlinks.json at https://gakseong.app/.well-known/assetlinks.json carrying this
              applicationId and the release SHA-256. Until that file is up, the link opens a chooser rather than
              the app, which is a degraded invite rather than a broken one.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gakseong.app" android:pathPrefix="/s/" />
            </intent-filter>

            <!--
              Health Connect requires a rationale destination, and refuses the permission flow without one. Both
              actions are declared because the name changed at API 34 and the old one is still used below it.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".session.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A bounded focus session the user started, showing its remaining time" />
        </service>

        <!--
          Containment. Off by default, earned by repeated failure, and granted in the system's own accessibility
          screen. §Verifiers: disclosed at onboarding, requested at the trigger, never on day one.
        -->
        <service
            android:name=".session.ContainmentService"
            android:exported="false"
            android:label="Containment"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/containment_service" />
        </service>

        <receiver
            android:name=".widget.DailyQuestReceiver"
            android:exported="false"
            android:label="Daily quest">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_quest" />
        </receiver>

        <receiver
            android:name=".widget.AuraReceiver"
            android:exported="false"
            android:label="Aura today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aura" />
        </receiver>

        <receiver
            android:name=".widget.NightGateReceiver"
            android:exported="false"
            android:label="Night gate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_night_gate" />
        </receiver>

        <receiver
            android:name=".widget.StreakReceiver"
            android:exported="false"
            android:label="Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>
    </application>

</manifest>
