<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics. Composition primitives fire even when the phone is on silent, which is the point. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Special access, not a runtime permission. Declaring it makes the app appear in the system's usage-access
      list; the grant itself only happens in Settings, via Settings.ACTION_USAGE_ACCESS_SETTINGS. Asked at the
      first quest that needs it, never at onboarding.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:label="Gakseong"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gakseong">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gakseong.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.DailyQuestReceiver"
            android:exported="false"
            android:label="Daily quest">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_quest" />
        </receiver>

        <receiver
            android:name=".widget.AuraReceiver"
            android:exported="false"
            android:label="Aura today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aura" />
        </receiver>

        <receiver
            android:name=".widget.NightGateReceiver"
            android:exported="false"
            android:label="Night gate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_night_gate" />
        </receiver>

        <receiver
            android:name=".widget.StreakReceiver"
            android:exported="false"
            android:label="Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>
    </application>

</manifest>
